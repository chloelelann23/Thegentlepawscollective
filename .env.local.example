# ── Stripe ───────────────────────────────────────────────────────────
# Get from: dashboard.stripe.com → Developers → API Keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Get from: dashboard.stripe.com → Developers → Webhooks → add endpoint → signing secret
# Endpoint URL: https://YOUR-VERCEL-URL/api/webhooks/stripe
# Event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# ── Instagram ────────────────────────────────────────────────────────
# Get from: developers.facebook.com → your app → Instagram Basic Display → User Token
# (optional — app shows placeholder posts without it)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ── App URL ──────────────────────────────────────────────────────────
# Set to your Vercel URL after first deploy, e.g. https://gentle-paws.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
